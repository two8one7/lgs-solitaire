{
  "name": "lgs-solitaire",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LGS Solitaire — daily Klondike solitaire for Local Games Service publishers.",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev --workspace=@2817/web",
    "build": "npm run build --workspace=@2817/web",
    "preview": "npm run preview --workspace=@2817/web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "node packages/personality-lint/lint-no-publisher-ifs.mjs apps/web/src"
  },
  "dependencies": {
    "pixi.js": "^8.14.3",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "jsdom": "^29.0.0",
    "typescript": "^5.6.3",
    "vitest": "^3.1.3"
  }
}
